<h1><%= @run.display_name %></h1>

<p>
  <%= @run.run_on %>
</p>

<h2>予約一覧</h2>

<%= link_to "この便で予約を作成",
  run_cars_path(
    @run,
    departure_station_id: @departure_station.id,
    arrival_station_id:   @arrival_station.id
  )
%>

<table>
  <tr>
    <th>ID</th>
    <th>名義</th>
    <th>区間</th>
    <th>発券</th>
    <th>操作</th>
  </tr>

  <% @reservations.each do |r| %>
    <tr>
      <td><%= r.id %></td>
      <td><%= r.holder_name %></td>
      <td>
        <%= r.departure_station.station_name %> →
        <%= r.arrival_station.station_name %>
      </td>
      <td><%= r.is_issued? ? "済" : "未" %></td>
      <td>
        <%= link_to "詳細", staff_reservation_path(r) %>
      </td>
    </tr>
  <% end %>
</table>
