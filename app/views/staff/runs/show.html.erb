<div class="app-main">
  <div class="container">

    <!-- ===== ページヘッダ ===== -->
    <div class="page-header">
      <h2>駅員｜便詳細</h2>
    </div>

    <!-- ===== 便情報 ===== -->
    <div class="panel run-detail">

      <div class="detail-section">
        <h3 class="section-title">運行情報</h3>

        <div class="detail-row">
          <span class="label">便名</span>
          <span><%= @run.display_name %></span>
        </div>

        <div class="detail-row">
          <span class="label">運行日</span>
          <span><%= @run.run_on.strftime("%Y/%m/%d") %></span>
        </div>

        <% if @departure_station && @arrival_station %>
          <div class="detail-row">
            <span class="label">区間</span>
            <span>
              <%= @departure_station.station_name %> →
              <%= @arrival_station.station_name %>
            </span>
          </div>

          <div class="detail-row">
            <span class="label">時刻</span>
            <span>
              <%= @run.departure_time_at(@departure_station).strftime("%H:%M") %>
              →
              <%= @run.arrival_time_at(@arrival_station).strftime("%H:%M") %>
            </span>
          </div>
        <% end %>
      </div>

    </div>

    <% if params[:return_to].present? %>
      <div class="between-panels">
        <%= link_to "検索結果に戻る",
          params[:return_to],
          class: "back-link" %>
      </div>
    <% end %>

    <% if @departure_station && @arrival_station %>
      <!-- ===== 空席状況 ===== -->
      <div class="panel seat-availability">
        <div class="detail-section">
          <div class="section-head">
            <h3 class="section-title">空席状況</h3>
          </div>

          <div class="seat-type-grid">
            <% seat_types = {
              "reserved" => "指定席",
              "green" => "グリーン",
              "fabulous" => "ファビュラス"
            } %>

            <% seat_types.each do |type, label| %>
              <% count = @run.available_count(
                car_type_name: type,
                departure_station: @departure_station,
                arrival_station: @arrival_station
              ) %>
              <% mark = @run.availability_mark(type, count) %>

              <% if mark == "×" %>
                <div class="seat-type-card disabled">
                  <div class="seat-type-label"><%= label %></div>
                  <div class="seat-type-mark"><%= mark %></div>
                </div>
              <% else %>
                <%= link_to run_cars_path(
                  @run,
                  departure_station_id: @departure_station.id,
                  arrival_station_id: @arrival_station.id,
                  seat_type: type
                ), class: "seat-type-card" do %>
                  <div class="seat-type-label"><%= label %></div>
                  <div class="seat-type-mark"><%= mark %></div>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- ===== 予約一覧 ===== -->
    <div class="panel reservation-list">

      <div class="detail-section">
        <div class="section-head">
          <h3 class="section-title">予約一覧</h3>
        </div>

        <% if @reservations.any? %>
          <table class="table">
            <thead>
              <tr>
                <th>ID</th>
                <th>名義</th>
                <th>区間</th>
                <th>発券</th>
                <th>操作</th>
              </tr>
            </thead>

            <tbody>
              <% @reservations.each do |r| %>
                <tr>
                  <td><%= r.id %></td>
                  <td><%= r.holder_name %></td>
                  <td>
                    <%= r.departure_station.station_name %> →
                    <%= r.arrival_station.station_name %>
                  </td>
                  <td>
                    <span class="status <%= r.is_issued? ? "issued" : "not-issued" %>">
                      <%= r.is_issued? ? "発券済" : "未発券" %>
                    </span>
                  </td>
                  <td>
                    <%= link_to "詳細",
                      staff_reservation_path(r, return_to: request.fullpath),
                      class: "btn btn-ghost btn-sm" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="empty-message">この便にはまだ予約がありません。</p>
        <% end %>

      </div>
    </div>

  </div>
</div>
