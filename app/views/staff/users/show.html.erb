<div class="app-main">
  <div class="container">

    <div class="page-header">
      <h2>利用者詳細</h2>
      <p class="page-description">利用者の基本情報と予約履歴を確認します</p>
    </div>

    <!-- ===== 基本情報 ===== -->
    <div class="panel">
      <h3 class="section-title">基本情報</h3>

      <div class="info-grid">
        <div class="info-row">
          <span class="label">ID</span>
          <span><%= @user.id %></span>
        </div>

        <div class="info-row">
          <span class="label">ログインID</span>
          <span><%= @user.login_id %></span>
        </div>

        <div class="info-row">
          <span class="label">氏名</span>
          <span><%= @user.user_fullname %></span>
        </div>

        <div class="info-row">
          <span class="label">区分</span>
          <span class="role-text <%= @user.role %>">
            <%= @user.role_label %>
          </span>
        </div>
      </div>
    </div>

    <!-- ===== 予約一覧 ===== -->
    <div class="panel">
      <h3 class="section-title">予約一覧</h3>

      <% if @reservations.any? %>
        <div class="reservation-rows">

          <div class="reservation-header">
            <span>ID</span>
            <span>運行日</span>
            <span>便名</span>
            <span>区間</span>
            <span>人数</span>
            <span>席種</span>
            <span>発券</span>
            <span></span>
          </div>

          <% @reservations.each do |r| %>
            <div class="reservation-row">
              <span class="col"><%= r.id %></span>

              <span class="col">
                <%= r.run.run_on.strftime("%Y-%m-%d") %>
              </span>

              <span class="col">
                <%= r.run.display_name %>
              </span>

              <span class="col">
                <%= r.departure_station.station_name %> →
                <%= r.arrival_station.station_name %>
              </span>

              <span class="col"><%= r.seats.size %>名</span>

              <span class="col">
                <%= r.seats.first.car.car_type.label %>
              </span>

              <span class="col status-text <%= r.is_issued? ? "issued" : "not-issued" %>">
                <%= r.is_issued? ? "済" : "未" %>
              </span>

              <span class="col">
                <%= link_to "詳細",
                  staff_reservation_path(r),
                  class: "btn btn-sm btn-ghost" %>
              </span>
            </div>
          <% end %>

        </div>
      <% else %>
        <p class="empty-text">予約はまだありません。</p>
      <% end %>
    </div>
          <div class="page-footer">
        <%= link_to "一覧に戻る",
          staff_users_path,
          class: "btn btn-ghost" %>
    </div> 
  </div>
</div>
