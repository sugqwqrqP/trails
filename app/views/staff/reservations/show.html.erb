<h1>予約詳細</h1>

<p>
  <strong><%= @reservation.run.display_name %></strong><br>
  <%= @reservation.departure_station.station_name %> →
  <%= @reservation.arrival_station.station_name %>
</p>

<p>予約番号：<%= @reservation.id %></p>
<p>予約者名義：<%= @reservation.holder_name %></p>
<p>
  発券状況:
  <%= @reservation.is_issued? ? "発券済み" : "未発券" %>
</p>

<% unless @reservation.is_issued? %>
  <%= button_to "発券する",
    issue_staff_reservation_path(@reservation),
    method: :patch,
    data: { confirm: "発券しますか？" } %>
<% end %>

<% unless @reservation.is_issued? %>
  <%= button_to "予約を削除",
    staff_reservation_path(@reservation),
    method: :delete,
    data: { confirm: "本当に削除しますか？" }
  %>
<% end %>
