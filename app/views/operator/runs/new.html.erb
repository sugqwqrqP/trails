<h1>便を追加</h1>

<%= form_with model: @run, url: operator_runs_path, local: true do |f| %>

  <% if @run.errors.any? %>
    <div class="alert">
      <%= @run.errors.full_messages.join(" / ") %>
    </div>
  <% end %>

  <div>
    <%= f.label :run_on, "運行日" %>
    <%= f.date_field :run_on %>
  </div>

  <div>
    <%= f.label :first_station_departure_time, "始発時刻" %>
    <%= f.time_field :first_station_departure_time %>
  </div>

  <div>
    <%= f.label :run_type_id, "種別" %>
    <%= f.collection_select :run_type_id, RunType.all, :id, :name %>
  </div>

  <div>
    <%= f.label :is_up, "方向" %>
    <%= f.select :is_up, [["下り", false], ["上り", true]] %>
  </div>

  <%= f.submit "追加" %>

<% end %>
