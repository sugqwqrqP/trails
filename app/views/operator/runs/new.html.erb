<div class="app-main">
  <div class="container">

    <div class="page-header">
      <h2>便を追加</h2>
    </div>

    <div class="panel auth-panel">
      <%= form_with model: @run, url: operator_runs_path, local: true do |f| %>

        <% if @run.errors.any? %>
          <div class="form-errors">
            <%= @run.errors.full_messages.join(" / ") %>
          </div>
        <% end %>

        <div class="form-section">
          <div class="form-row">
            <%= f.label :run_on, "運行日" %>
            <%= f.date_field :run_on,
              min: Date.current + 1,
              max: Date.current + 14 %>
          </div>

          <div class="form-row">
            <%= f.label :first_station_departure_time, "始発時刻" %>
            <%= f.time_field :first_station_departure_time %>
          </div>

          <div class="form-row">
            <%= f.label :run_type_id, "種別" %>
            <%= f.collection_select :run_type_id, RunType.all, :id, :name %>
          </div>

          <div class="form-row">
            <%= f.label :is_up, "方向" %>
            <%= f.select :is_up, [["下り", false], ["上り", true]] %>
          </div>
        </div>

        <div class="form-actions">
          <%= f.submit "追加", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>

    <div class="between-panels">
      <%= link_to "一覧に戻る", operator_runs_path, class: "back-link" %>
    </div>
  </div>
</div>
