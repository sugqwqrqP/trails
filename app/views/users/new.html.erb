<div class="app-main">
  <div class="container">

    <div class="page-header">
      <h2>新規登録</h2>
    </div>

    <div class="panel auth-panel">

      <%= form_with model: @user, local: true do |f| %>

        <div class="form-section">

          <!-- ログインID -->
          <div class="form-card <%= 'has-error' if @user.errors[:login_id].any? %>">
            <div class="form-row">
              <%= f.label :login_id, "ログインID" %>
              <%= f.text_field :login_id, autocomplete: "username" %>
              <% if @user.errors[:login_id].blank? %>
                <div class="field-help">6〜20文字</div>
                <div class="field-help">英数字と _ のみ使用できます</div>
              <% end %>

              <% @user.errors[:login_id].each do |msg| %>
                <div class="field-error"><%= msg %></div>
              <% end %>
            </div>
          </div>

          <!-- 氏名 -->
          <div class="form-card <%= 'has-error' if @user.errors[:user_fullname].any? %>">
            <div class="form-row">
              <%= f.label :user_fullname, "氏名" %>
              <%= f.text_field :user_fullname %>

              <% @user.errors[:user_fullname].each do |msg| %>
                <div class="field-error"><%= msg %></div>
              <% end %>
            </div>
          </div>

          <!-- パスワード -->
          <div class="form-card <%= 'has-error' if @user.errors[:password].any? %>">
            <div class="form-row">
              <%= f.label :password, "パスワード" %>

              <div class="password-field">
                <%= f.password_field :password,
                  id: "signup-password",
                  autocomplete: "new-password" %>

                <button
                  type="button"
                  class="password-toggle"
                  data-target="signup-password"
                  aria-label="パスワードを表示">
                  👁
                </button>
              </div>
              <% if @user.errors[:password].blank? %>
                <div class="field-help">6〜20文字</div>
                <div class="field-help">大文字・小文字・数字・記号（@¥!$&）を必ず使用してください</div>
              <% end %>

              <% @user.errors[:password].each do |msg| %>
                <div class="field-error"><%= msg %></div>
              <% end %>
            </div>

            <!-- パスワード確認 -->
            <div class="form-row">
              <%= f.label :password_confirmation, "パスワード（確認）" %>

              <div class="password-field">
                <%= f.password_field :password_confirmation,
                  id: "signup-password-confirm",
                  autocomplete: "new-password" %>

                <button
                  type="button"
                  class="password-toggle"
                  data-target="signup-password-confirm"
                  aria-label="パスワードを表示">
                  👁
                </button>
              </div>
            </div>
          </div>

        </div>

        <div class="form-actions">
          <%= f.submit "登録する",
            class: "btn btn-primary" %>
        </div>

      <% end %>

    </div>

  </div>
</div>
