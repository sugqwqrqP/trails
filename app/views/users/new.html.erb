<h1>新規登録</h1>

<%= form_with model: @user, local: true do |f| %>

  <!-- ログインID -->
  <div class="field <%= 'has-error' if @user.errors[:login_id].any? %>">
    <%= f.label :login_id, "ログインID" %><br>
    <%= f.text_field :login_id %>

    <% @user.errors[:login_id].each do |msg| %>
      <div class="error-message"><%= msg %></div>
    <% end %>
  </div>

  <!-- 氏名 -->
  <div class="field <%= 'has-error' if @user.errors[:user_fullname].any? %>">
    <%= f.label :user_fullname, "氏名" %><br>
    <%= f.text_field :user_fullname %>

    <% @user.errors[:user_fullname].each do |msg| %>
      <div class="error-message"><%= msg %></div>
    <% end %>
  </div>

  <!-- パスワード -->
  <div class="field <%= 'has-error' if @user.errors[:password].any? %>">
    <%= f.label :password, "パスワード" %><br>
    <%= f.password_field :password %>

    <% @user.errors[:password].each do |msg| %>
      <div class="error-message"><%= msg %></div>
    <% end %>
  </div>

  <!-- パスワード確認 -->
  <div class="field <%= 'has-error' if @user.errors[:password_confirmation].any? %>">
    <%= f.label :password_confirmation, "パスワード（確認）" %><br>
    <%= f.password_field :password_confirmation %>
  </div>

  <%= f.submit "登録" %>

<% end %>
  <p><%= link_to "トップページに戻る", root_path %></p>
