<div class="app-main">
  <div class="container">

    <div class="page-header">
      <h2>会員情報変更</h2>
    </div>

    <div class="panel account-edit-panel">

      <%= form_with model: @user, local: true do |f| %>

        <!-- ログイン情報 -->
        <div class="form-section">
          <h3 class="section-title">ログイン情報</h3>

          <div class="form-row">
            <%= f.label :login_id, "ログインID" %>
            <%= f.text_field :login_id, disabled: true %>
            <p class="form-note">ログインIDは変更できません。</p>
          </div>
        </div>

        <!-- 個人情報 -->
        <div class="form-section">
          <h3 class="section-title">個人情報</h3>

          <div class="form-row">
            <%= f.label :user_fullname, "氏名" %>
            <%= f.text_field :user_fullname %>
            <% @user.errors.full_messages_for(:user_fullname).each do |msg| %>
              <div class="field-error"><%= msg %></div>
            <% end %>
          </div>
        </div>

        <!-- パスワード -->
        <div class="form-section">
          <h3 class="section-title">パスワード</h3>

          <div class="form-row">
            <%= f.label :password, "新しいパスワード" %>
            <%= f.password_field :password %>
            <p class="form-note">変更しない場合は空欄のままにしてください。</p>
            <% @user.errors.full_messages_for(:password).each do |msg| %>
              <div class="field-error"><%= msg %></div>
            <% end %>
          </div>

          <div class="form-row">
            <%= f.label :password_confirmation, "パスワード（確認）" %>
            <%= f.password_field :password_confirmation %>
          </div>
        </div>

        <!-- 保存 -->
        <div class="form-actions">
          <%= link_to "マイページに戻る",
            user_path(@user),
            class: "btn btn-ghost" %>

          <%= f.submit "更新する",
            class: "btn btn-primary" %>
        </div>

      <% end %>
    </div>

  </div>
</div>
