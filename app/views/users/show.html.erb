<div class="app-main">
  <div class="container">
    <div class="page-header">
      <h2>マイページ</h2>
    </div>

    <!-- ===== 予約一覧 ===== -->
    <div class="panel mypage-panel">
      <h3 class="section-title">予約一覧</h3>

      <div class="reservation-list">
        <% if @reservations.any? %>
          <% @reservations.each do |r| %>
            <% run = r.run %>
            <% seats = r.reservation_seats.map(&:seat) %>
            <% car_type = seats.first.car.car_type.name %>

            <div class="reservation-card compact">
              <div class="reservation-main">
                <div class="reservation-left">
                  <div class="run-name"><%= run.display_name %></div>

                  <div class="route">
                    <%= r.departure_station.station_name %> →
                    <%= r.arrival_station.station_name %>
                  </div>

                  <div class="time">
                    <%= run.departure_time_at(r.departure_station).strftime("%H:%M") %>
                    →
                    <%= run.arrival_time_at(r.arrival_station).strftime("%H:%M") %>
                  </div>

                  <div class="meta">
                    <%= seat_type_label(car_type) %> /
                    <%= seats.count %>人
                  </div>
                </div>

                <div class="reservation-right">
                  <div class="run-date">
                    <%= run.run_on.strftime("%Y/%m/%d") %>
                  </div>

                  <%= link_to "詳細",
                    user_reservation_path(@user, r),
                    class: "detail-btn" %>
                </div>
              </div>

              <% if r.is_issued %>
                <span class="status issued">発券済</span>
              <% else %>
                <span class="status not-issued">未発券</span>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="empty-text">
            現在、予約はありません。
          </p>
        <% end %>
      </div>
    </div>

    <!-- ===== アカウント（設定領域） ===== -->
    <div class="panel account-panel">
      <h3 class="section-title">会員情報</h3>

      <div class="account-row">
        <span class="label">氏名</span>
        <span><%= @user.user_fullname %></span>
      </div>

      <div class="account-row">
        <span class="label">ログインID</span>
        <span><%= @user.login_id %></span>
      </div>

      <div class="account-footer">
        <%= link_to "会員情報を変更する",
          edit_user_path(@user),
          class: "account-edit-link" %>
      </div>
    </div>

    <!-- 退会 -->
    <div class="panel danger-panel">
      <h3 class="section-title danger">退会</h3>

      <p class="danger-text">
        退会すると、すべての予約情報が削除されます。
        この操作は取り消せません。
      </p>

      <div class="danger-actions">
        <%= button_to "退会する",
          user_path(@user),
          method: :delete,
          data: { confirm: "本当に退会しますか？この操作は取り消せません。" },
          class: "btn btn-danger" %>
      </div>
    </div>

  </div>
</div>
