<h1>予約確認</h1>

<p>
  <strong><%= @run.display_name %></strong><br>
  <%= @car.number %>号車（<%= @car.car_type.name %>）<br>
  座席：
  <%= @seats.map { |s| "#{s.row}#{s.column}" }.join(", ") %>
</p>

<% fee_per_seat =
  @run.fee_per_seat(
    departure_station: @departure_station,
    arrival_station:   @arrival_station,
    car_type:          @car.car_type
  )
%>

<p>
  1席あたり料金：
  <strong><%= number_to_currency(fee_per_seat, unit: "¥", precision: 0) %></strong>
</p>

<p>
  人数：<%= @seats.size %>名
</p>

<p>
  合計料金：
  <strong>
    <%= number_to_currency(
      fee_per_seat * @seats.size,
      unit: "¥",
      precision: 0
    ) %>
  </strong>
</p>



<%= form_with url: reservations_path, method: :post, local: true do %>
  <%= hidden_field_tag :run_id, @run.id %>
  <%= hidden_field_tag :car_id, @car.id %>
  <%= hidden_field_tag :departure_station_id, params[:departure_station_id] %>
  <%= hidden_field_tag :arrival_station_id, params[:arrival_station_id] %>


  <% @seats.each do |seat| %>
    <%= hidden_field_tag "seat_ids[]", seat.id %>
    
  <% end %>

  <%= submit_tag "確定する" %>
<% end %>

<%= link_to "座席選択に戻る",
  run_car_seats_path(
    @run,
    car_id: @car.id,
    departure_station_id: params[:departure_station_id],
    arrival_station_id:   params[:arrival_station_id],
    run_on:               params[:run_on],
    time:                 params[:time],
    time_basis:           params[:time_basis]
  )
%>
