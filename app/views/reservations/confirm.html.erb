<div class="app-main">
  <div class="container">

    <%= render "shared/reservation_steps", current_step: 4 %>

    <div class="page-header">
      <h2>予約確認</h2>
    </div>

    <div class="panel">
      <div class="confirm-summary">
        <p class="run-summary run-inline">
          <strong class="run-name"><%= @run.display_name %></strong>
          <span class="run-car">
            <%= @car.number %>号車（
            <%=
              case @car.car_type.name
              when "reserved" then "指定席"
              when "green"    then "グリーン車"
              when "fabulous" then "ファビュラスルーム"
              end
            %>
            ）
          </span>
        </p>
      </div>

      <div class="confirm-block">
        <div class="confirm-row">
          <span class="label">日付</span>
          <span><%= @run.run_on %></span>
        </div>

        <div class="confirm-row">
          <span class="label">区間</span>
          <span>
            <%= @departure_station.station_name %> →
            <%= @arrival_station.station_name %>
          </span>
        </div>

        <div class="confirm-row">
          <span class="label">時刻</span>
          <span>
            <%= @departure_time.strftime("%H:%M") %> →
            <%= @arrival_time.strftime("%H:%M") %>
          </span>
        </div>

        <div class="confirm-row">
          <span class="label">座席</span>
          <span>
            <%= @seats.map { |s| "#{s.row}#{s.column}" }.join(", ") %>
          </span>
        </div>
      </div>

      <hr>

      <div class="confirm-block">
        <div class="confirm-row">
          <span class="label">予約者名義</span>
          <strong><%= @holder_name %></strong>
        </div>

        <div class="confirm-row">
          <span class="label">1席あたり</span>
          <strong>
            <%= number_to_currency(@fee_per_seat, unit: "¥", precision: 0) %>
          </strong>
        </div>

        <div class="confirm-row">
          <span class="label">人数</span>
          <span><%= @seats.size %>名</span>
        </div>

        <div class="confirm-row total">
          <span class="label">合計料金</span>
          <strong>
            <%= number_to_currency(@total_fee, unit: "¥", precision: 0) %>
          </strong>
        </div>
      </div>
    </div>

    <%= form_with url: reservations_path, method: :post, local: true do %>
      <%= hidden_field_tag :run_id, @run.id %>
      <%= hidden_field_tag :car_id, @car.id %>
      <%= hidden_field_tag :departure_station_id, @departure_station.id %>
      <%= hidden_field_tag :arrival_station_id, @arrival_station.id %>
      <%= hidden_field_tag :holder_name, @holder_name %>

      <% @seats.each do |seat| %>
        <%= hidden_field_tag "seat_ids[]", seat.id %>
      <% end %>

      <button class="btn btn-primary" style="width:100%; margin-top:16px;">
        確定する
      </button>
    <% end %>

    <%= link_to "座席選択に戻る",
      run_car_seats_path(@run, @car, request.query_parameters),
      class: "back-link" %>

  </div>
</div>
