<h1>予約完了</h1>

<p class="notice">
  予約が正常に完了しました。
</p>

<hr>

<p>
  <strong>予約番号：</strong>
  <%= @reservation.id %>
</p>

<p>
  <strong>予約者名義：</strong>
  <%= @reservation.holder_name %>
</p>

<p>
  <strong>区間：</strong>
  <%= @reservation.departure_station.station_name %>
  →
  <%= @reservation.arrival_station.station_name %>
</p>

<p>
  <strong>列車：</strong>
  <%= @reservation.run.display_name %>
</p>

<p>
  <strong>座席：</strong>
  <%= @reservation.seats.map { |s| "#{s.row}#{s.column}" }.join(", ") %>
</p>

<hr>

<p>
  <% if current_user.staff? %>
    <%= link_to "駅員トップに戻る", staff_root_path %>
  <% else %>
    <%= link_to "トップに戻る", root_path %>
  <% end %>
</p>
