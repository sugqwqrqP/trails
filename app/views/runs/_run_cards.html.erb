<% results.each do |result| %>
  <% run = result[:run] %>

  <div class="run-card">
    <div class="run-main">

      <!-- 左：列車情報 -->
      <div class="run-info">
        <div class="run-name">
          <%= run.run_type.name %> <%= run.run_number %>号
        </div>

        <div class="run-time-big">
          <%= result[:departure_time].strftime("%H:%M") %>
          <span class="arrow">→</span>
          <%= result[:arrival_time].strftime("%H:%M") %>
        </div>

        <div class="run-sub">
          所要 <%= result[:travel_min] %>分
        </div>
      </div>

      <!-- 右：空席案内（横並び） -->
      <div class="seat-status">
        <% reserved_mark = result[:availability][:reserved][:mark] %>
        <% reserved_class = reserved_mark.start_with?("残り") ? "seat-mark small" : "seat-mark" %>
        <% if reserved_mark == "×" %>
          <div class="seat-type-btn reserved disabled">
            <span class="seat-label">指定席</span>
            <span class="<%= reserved_class %>"><%= reserved_mark %></span>
          </div>
        <% else %>
          <%= link_to run_cars_path(
                run,
                request.query_parameters.merge(seat_type: "reserved")
              ),
              class: "seat-type-btn reserved" do %>
            <span class="seat-label">指定席</span>
            <span class="<%= reserved_class %>"><%= reserved_mark %></span>
          <% end %>
        <% end %>

        <% green_mark = result[:availability][:green][:mark] %>
        <% green_class = green_mark.start_with?("残り") ? "seat-mark small" : "seat-mark" %>
        <% if green_mark == "×" %>
          <div class="seat-type-btn green disabled">
            <span class="seat-label">グリーン</span>
            <span class="<%= green_class %>"><%= green_mark %></span>
          </div>
        <% else %>
          <%= link_to run_cars_path(
                run,
                request.query_parameters.merge(seat_type: "green")
              ),
              class: "seat-type-btn green" do %>
            <span class="seat-label">グリーン</span>
            <span class="<%= green_class %>"><%= green_mark %></span>
          <% end %>
        <% end %>

        <% fabulous_mark = result[:availability][:fabulous][:mark] %>
        <% fabulous_class = fabulous_mark.start_with?("残り") ? "seat-mark small" : "seat-mark" %>
        <% if fabulous_mark == "×" %>
          <div class="seat-type-btn fabulous disabled">
            <span class="seat-label">ファビュラス</span>
            <span class="<%= fabulous_class %>"><%= fabulous_mark %></span>
          </div>
        <% else %>
          <%= link_to run_cars_path(
                run,
                request.query_parameters.merge(seat_type: "fabulous")
              ),
              class: "seat-type-btn fabulous" do %>
            <span class="seat-label">ファビュラス</span>
            <span class="<%= fabulous_class %>"><%= fabulous_mark %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
