<div class="app-main">
  <div class="container">

<div class="container">
  <% if @errors.present? && @errors.any? %>
    <div class="flash alert">
      <%= @errors.join(" / ") %>
    </div>
  <% end %>
</div>

<!-- デフォルト値の設定 -->
<% default_departure =
    params[:departure_station_id] ||
    Station.find_by(station_name: "東京")&.id %>

<% default_arrival =
    params[:arrival_station_id] ||
    Station.find_by(station_name: "新大阪")&.id %>

<% default_run_on = params[:run_on] || Date.current %>
<% default_time   = params[:time]   || Time.current.strftime("%H:%M") %>

<div class="container">
  <div class="search-panel">
    <%= form_with url: runs_path, method: :get, local: true do |f| %>

      <!-- 出発 -->
      <div class="location-row">
        <div class="location-label depart">出発</div>
        <div class="location-input">
          <%= f.collection_select :departure_station_id,
            Station.order(:station_order),
            :id,
            :station_name,
            { selected: default_departure },
            { class: "station-select" } %>
        </div>
      </div>

      <!-- 入れ替え -->
      <div class="route-tools">
        <div class="route-icons">
          <button type="button" id="swap-stations" class="icon-btn">⇅</button>
        </div>
      </div>

      <!-- 到着 -->
      <div class="location-row">
        <div class="location-label arrive">到着</div>
        <div class="location-input">
          <%= f.collection_select :arrival_station_id,
            Station.order(:station_order),
            :id,
            :station_name,
            { selected: default_arrival },
            { class: "station-select" } %>
        </div>
      </div>

      <div class="datetime-box">
        <% default_run_on =
            params[:run_on].present? ? Date.parse(params[:run_on]) : Date.current %>

        <div class="datetime-click" id="date-display">
          📅
          <span id="date-text"><%= default_run_on.strftime("%Y/%m/%d") %></span>
        </div>

        <%= f.date_field :run_on,
          value: default_run_on,
          class: "date-input" %>

        <%= f.date_field :run_on,
              value: default_run_on,
              class: "date-input",
              id: "date-input" %>

        <!-- 時刻 -->
        <div class="datetime-click" id="time-display">
          🕒
          <span id="time-text"><%= default_time %></span>
        </div>

        <button
          type="button"
          id="now-time-btn"
          class="now-btn">
          現在時刻
        </button>

        <%= f.time_field :time,
              value: default_time,
              class: "time-input",
              id: "time-input" %>

        <%= f.select :time_basis,
              [["出発時刻", "departure"], ["到着時刻", "arrival"]],
              {},
              { class: "basis-select" } %>
      </div>
      

      <!-- 検索 -->
      <%= f.submit "検索", class: "search-btn" %>

    <% end %>
  </div>
</div>


<div class="container results">
  <%= render partial: "run_cards", locals: { results: @results } %>
</div>

<div class="container">
  <div class="pager">
    <% if @has_prev %>
      <%= link_to "← 前に戻る",
        runs_path(params.permit!.merge(offset: @prev_offset)),
        class: "pager-btn prev" %>
    <% end %>

    <% if @has_next %>
      <%= link_to "次を検索 →",
        runs_path(params.permit!.merge(offset: @next_offset)),
        class: "pager-btn next" %>
    <% end %>
  </div>
</div> 


<script>
  document.addEventListener("DOMContentLoaded", () => {
    const swapBtn = document.getElementById("swap-stations");
    if (!swapBtn) return;

    swapBtn.addEventListener("click", () => {
      const dep = document.querySelector("[name='departure_station_id']");
      const arr = document.querySelector("[name='arrival_station_id']");
      if (!dep || !arr) return;

      const tmp = dep.value;
      dep.value = arr.value;
      arr.value = tmp;
    });
  });
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const dateDisplay = document.getElementById("date-display");
  const dateInput   = document.getElementById("date-input");
  const dateText    = document.getElementById("date-text");

  const timeDisplay = document.getElementById("time-display");
  const timeInput   = document.getElementById("time-input");
  const timeText    = document.getElementById("time-text");
  const nowBtn      = document.getElementById("now-time-btn");

  // 日付：文字クリックでカレンダー
  dateDisplay.addEventListener("click", () => {
    if (dateInput.showPicker) {
      dateInput.showPicker();
    } else {
      dateInput.focus();
    }
  });

  // 時刻：文字クリックで時刻ピッカー
  timeDisplay.addEventListener("click", () => {
    if (timeInput.showPicker) {
      timeInput.showPicker();
    } else {
      timeInput.focus();
    }
  });

  // 値変更時に表示更新
  dateInput.addEventListener("change", () => {
    dateText.textContent = dateInput.value.replaceAll("-", "/");
  });

  timeInput.addEventListener("change", () => {
    timeText.textContent = timeInput.value;
  });
  
  // 現在時刻ボタン
  if (nowBtn) {
    nowBtn.addEventListener("click", () => {
      const now = new Date();
      const hh = String(now.getHours()).padStart(2, "0");
      const mm = String(now.getMinutes()).padStart(2, "0");
      const current = `${hh}:${mm}`;

      timeInput.value = current;
      timeText.textContent = current;
    });
  }
});
</script>
