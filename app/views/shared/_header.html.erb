<header class="app-header">
  <div class="app-header-inner">

    <!-- ロゴ -->
    <div class="app-logo">
      <% if logged_in? %>
        <% case current_user.role %>
        <% when "staff" %>
          <%= link_to "新幹線予約", staff_root_path, class: "logo-link" %>
        <% when "operator" %>
          <%= link_to "新幹線予約", operator_root_path, class: "logo-link" %>
        <% else %>
          <%= link_to "新幹線予約", root_path, class: "logo-link" %>
        <% end %>
      <% else %>
        <%= link_to "新幹線予約", root_path, class: "logo-link" %>
      <% end %>
    </div>

    <!-- ユーザー操作 -->
    <nav class="app-nav">
      <% if logged_in? %>
        <% case current_user.role %>
        <% when "staff" %>
          <%= link_to "駅員トップ", staff_root_path %>
          <span class="nav-sep">|</span>
          <%= link_to "ログアウト", login_path, method: :delete %>

        <% when "operator" %>
          <%= link_to "運行管理者トップ", operator_root_path %>
          <span class="nav-sep">|</span>
          <%= link_to "ログアウト", login_path, method: :delete %>

        <% else %>
          <%= link_to current_user.user_fullname, user_path(current_user) %>
          <span class="nav-sep">|</span>
          <%= link_to "ログアウト", login_path, method: :delete %>
        <% end %>
      <% else %>
        <%= link_to "ログイン", new_login_path %>
        <span class="nav-sep">|</span>
        <%= link_to "新規登録", new_user_path %>
      <% end %>
    </nav>

  </div>
</header>
