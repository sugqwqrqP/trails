<% role_class = logged_in? ? "is-#{current_user.role}" : "" %>
<header class="app-header <%= role_class %>">
  <div class="app-header-inner">

    <!-- ロゴ -->
    <div class="app-logo">
      <% if logged_in? %>
        <% case current_user.role %>
        <% when "staff" %>
          <%= link_to staff_root_path, class: "logo-link" do %>
            <%= image_tag "logo_moji.svg", alt: "Trails", class: "logo-img" %>
            <span class="logo-text">
              <span class="logo-subtitle">新幹線予約</span>
              <span class="logo-title">Trails</span>
            </span>
          <% end %>
        <% when "operator" %>
          <%= link_to operator_root_path, class: "logo-link" do %>
            <%= image_tag "logo_moji.svg", alt: "Trails", class: "logo-img" %>
            <span class="logo-text">
              <span class="logo-subtitle">新幹線予約</span>
              <span class="logo-title">Trails</span>
            </span>
          <% end %>
        <% else %>
          <%= link_to root_path, class: "logo-link" do %>
            <%= image_tag "logo_moji.svg", alt: "Trails", class: "logo-img" %>
            <span class="logo-text">
              <span class="logo-subtitle">新幹線予約</span>
              <span class="logo-title">Trails</span>
            </span>
          <% end %>
        <% end %>
      <% else %>
        <%= link_to root_path, class: "logo-link" do %>
          <%= image_tag "logo_moji.svg", alt: "Trails", class: "logo-img" %>
          <span class="logo-text">
              <span class="logo-subtitle">新幹線予約</span>
              <span class="logo-title">Trails</span>
          </span>
        <% end %>
      <% end %>
    </div>

    <!-- ユーザー操作 -->
    <nav class="app-nav">
      <% if logged_in? %>
        <% case current_user.role %>
        <% when "staff" %>
          <%= link_to "駅員トップ", staff_root_path %>
          <span class="nav-sep">|</span>
          <%= link_to "ログアウト", login_path, method: :delete %>

        <% when "operator" %>
          <%= link_to "運行管理者トップ", operator_root_path %>
          <span class="nav-sep">|</span>
          <%= link_to "ログアウト", login_path, method: :delete %>

        <% else %>
          <%= link_to "マイページ", user_path(current_user) %>
          <span class="nav-sep">|</span>
          <%= link_to "ログアウト", login_path, method: :delete %>
        <% end %>
      <% else %>
        <%= link_to "ログイン", new_login_path %>
        <span class="nav-sep">|</span>
        <%= link_to "新規登録", new_user_path %>
      <% end %>
    </nav>

  </div>
</header>
