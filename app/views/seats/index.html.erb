<h1>座席選択</h1>

<p>
  <strong><%= @run.name %></strong><br>
  <%= @car.number %>号車（<%= @car.car_type.name %>）
</p>

<div
  id="seat-map"
  data-car-type="<%= @car.car_type.name %>">

  <% @seats.each do |seat| %>
    <button
      type="button"
      class="seat"
      data-seat="<%= seat.id %>">
      <%= seat.row %><%= seat.column %>
    </button>
  <% end %>
</div>

<form action="/reservations/confirm" method="get">
  <input type="hidden" name="seat_ids" id="selected-seats">
  <input type="hidden" name="run_id" value="<%= @run.id %>">
  <input type="hidden" name="car_id" value="<%= @car.id %>">

  <button id="confirm-btn" style="display:none;">
    予約確認へ
  </button>
</form>
